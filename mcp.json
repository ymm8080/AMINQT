{
  "mcpServers": {
    "duckdb": {
      "command": "duckdb-mcp",
      "args": [],
      "env": {
        "DUCKDB_PATH": "data/quant.duckdb"
      }
    },
    "deepseek-sub-agent": {
      "command": "python",
      "args": ["-m", "services.deepseek_sub_agent"],
      "env": {
        "DEEPSEEK_API_KEY": "",
        "DEEPSEEK_MODEL": "deepseek-v4-flash",
        "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
        "DEEPSEEK_MAX_TOKENS": "8192",
        "DEEPSEEK_TIMEOUT_SEC": "60"
      }
    }
  }
}