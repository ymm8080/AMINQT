{
  "main": {
    "pipeline": "bruteforce_dedup",
    "data_window": "3Y",
    "nan_threshold": 0.95,
    "dedup_threshold": 0.7
  },
  "dual": {
    "pipeline": "gate_d",
    "data_window": "1Y",
    "nan_threshold": 0.95,
    "gate_d": {
      "min_features": 30,
      "saturation_pct": 0.95,
      "label": "label_pm_1d_net"
    }
  },
  "fallback": {
    "pipeline": "ic_screener"
  },
  "dim_gating": {
    "dim01_price_volume": true,
    "dim02_turnover": true,
    "dim03_amplitude": true,
    "dim04_volume_price": true,
    "dim05_ma_trend": true,
    "dim06_momentum": true,
    "dim07_volatility": true,
    "dim08_fundamental": true,
    "dim09_forward_signal": false,
    "dim21_cyq_chip": false
  }
}
