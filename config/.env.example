# Data source: ifind | akshare
AMINQT_DATA_SOURCE=akshare

# iFinD credentials (only needed when AMINQT_DATA_SOURCE=ifind)
IFIND_USER=
IFIND_PASSWORD=

# Execution: broker sim|xt  (xt = miniQMT)
AMINQT_BROKER=sim
# Execution mode: auto|manual
AMINQT_EXEC_MODE=manual

# Tushare Pro API token (cyq_perf 筹码分布 / daily_basic 财务数据)
TUSHARE_TOKEN=

# Non-parquet data output directory (logs, JSON, CSV, DB outside repo data/)
# Defaults to PROJECT_ROOT.parent / "DATA OTHERS"
# AMINQT_DATA_OTHERS=D:/AMINQT/DATA OTHERS
