# AMINQT environment configuration
# Copy to .env and fill in your values
# NEVER commit .env to git (it is in .gitignore)

# Data source: ifind | akshare
AMINQT_DATA_SOURCE=akshare

# iFinD credentials (only needed when AMINQT_DATA_SOURCE=ifind)
IFIND_USER=
IFIND_PASSWORD=

# Execution: broker sim|xt  (xt = miniQMT)
AMINQT_BROKER=sim
# Execution mode: auto|manual
AMINQT_EXEC_MODE=manual

# Tushare Pro API token (cyq_perf 筹码分布 / daily_basic 财务数据)
# Get your token at https://tushare.pro/register
TUSHARE_TOKEN=

# DeepSeek API key (for AI-assisted code review / sentiment analysis)
# Get your key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# FastAPI API key (for authenticating API requests)
# Set to a random string; clients must send X-API-Key header
AMINQT_API_KEY=

# V3 Panel path — single source of truth for all components
# _daily_fetch.py writes here; Dashboard/API/Streamlit all read from here
PANEL_PATH=D:\AMINQT\PARQUET\panel_full_enriched_v3.parquet

# Non-parquet data output directory (logs, JSON, CSV, DB outside repo data/)
# Defaults to PROJECT_ROOT.parent / "DATA OTHERS"
# AMINQT_DATA_OTHERS=D:/AMINQT/DATA OTHERS
