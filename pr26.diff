+            sellable_qty=0,
+            entry_price=100.0,
+            entry_date="2026-07-25",
+        )
+        assert not pos.can_sell()  # 当日买入锁死 (满仓的代价)
+        assert pos.on_sell(100) == 0  # 物理不可卖
+        pos.settle_overnight()
+        assert pos.can_sell() and pos.hold_days == 1
+        assert pos.on_sell(100) == 100
