+"""V3.8 第七批: D.10 B/C 裁决协议."""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from app.pipeline1.backtest_adjudication import (
+    CRISIS_SEGMENTS,
+    BacktestJournal,
+    adjudicate_b_vs_c,
+    inject_tail_shocks,
+    resolve_range,
+    segment_robustness,
+    worst_trades_audit,
+)
