+        assert not buy_window_open("14:40", bear_state="DEFENSE")  # 只卖不买
+        assert not buy_window_open(
+            "09:50", bear_state="RECOVERY", signal_grade="A"
+        )  # 首周早盘关闭
+        assert buy_window_open("14:40", bear_state="RECOVERY")  # 尾盘仍开
