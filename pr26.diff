+        assert not buy_window_open("09:50", signal_grade="B")  # 早盘仅 A 级
+        assert not buy_window_open("11:00")  # 盘中只卖不买
+        assert buy_window_open("14:40")  # 尾盘主窗口 (不限等级)
+        assert sell_window_open("14:45") and not sell_window_open("13:00")
