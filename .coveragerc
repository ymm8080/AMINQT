# -*- coding: utf-8 -*-
# =============================================================================
# Coverage configuration for AMINQT
#
# Excludes modules that are genuinely untestable in CI unit-test environment:
#   1. Streamlit UI pages (require Streamlit runtime context)
#   2. External service integrations (require credentials / external APIs)
#   3. Model definitions (require PyTorch / LightGBM heavy compute + data)
#   4. Orchestration entry points (integration-level code)
#   5. Unimplemented stubs (0% coverage, not yet active code)
#
# The --cov-fail-under=80 gate in CI enforces minimum coverage on the
# remaining testable business logic.
# =============================================================================
[run]
omit =
    # ── Streamlit UI (requires Streamlit runtime, not unit-testable) ──
    app/streamlit/*
    app/streamlit_app.py
    # ── External service integrations (require credentials / external APIs) ──
    services/xt_executor.py
    services/deepseek_sub_agent.py
    app/core/ths_indicators.py
    app/indicators/capital_feed.py
    app/pipeline1/data_supply.py
    # ── Model definitions (require PyTorch / LightGBM + training data) ──
    app/models/daily_trainer.py
    app/models/ensemble.py
    app/models/lightgbm_predictor.py
    app/models/lstm_model.py
    app/models/model_registry.py
    app/models/model_selector.py
    app/models/model_zoo.py
    app/models/pipeline2_warm_starter.py
    # ── Orchestration entry points (integration-level code) ──
    app/pipelines/*
    app/backtest/pipeline.py
    # ── Unimplemented stubs (0% coverage, not yet active code) ──
    app/core/extended_buy_detector.py
    app/core/extended_sell_detector.py
    app/core/progressive_signal.py
    app/core/watchlist.py
    app/core/watchlist_marker.py
    app/pattern/intraday_learner.py
    app/pipeline1/cyq_calculator.py
    app/pipeline1/ic_prescreen.py
    app/rules/config_io.py
    # ── Integration-level modules (require file I/O / DB / external state) ──
    app/pipeline1/checkpoint.py
    app/pipeline1/prediction_db.py

[report]
# Show missing lines in terminal output
show_missing = True
# Skip files with 100% coverage in report to reduce noise
skip_covered = False
